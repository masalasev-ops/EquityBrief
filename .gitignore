# the store
/data/
/data-ci/

# local scratch archive of build prompts
/prompts/

# harness output, regenerated every run and never a reference
/artifacts/

# secrets, plaintext and never committed
**/appsettings.Secrets.json

# build
bin/
obj/
*.user
.vs/
.idea/
.DS_Store

# local harness settings, per machine and not a corpus document, except the
# path-scoped rules, which are corpus text placed where it loads. The star form
# is required: a directory git has excluded is never descended into, so
# `/.claude/` with a negation under it leaves the rules untracked and every
# check over them silently reading nothing.
/.claude/*
!/.claude/rules/
