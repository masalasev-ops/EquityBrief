#!/usr/bin/env bash
# Builds the setup ledger's history by hand from a clean copy of the committed
# code, as tools/nightly builds a night: the main checkout's own HEAD, read with
# no fetch, exported whole with `git archive` into the data root's folder of
# nights, one folder a commit, built once in Release and reused where a night
# built that commit already; the data root and the secrets file are the
# checkout's, each named by absolute path, so the copy never finds, creates or
# writes a store of its own. A checkout off main, or holding a commit
# origin/main does not have, is refused before any worker exists.
#
# The worker then reads one index's history over the span, waits for the night
# and for the store's copy, holds the drain's lock while it writes each chunk of
# sessions, and goes on from the sessions of the span it has not written.
#
#   tools/ledger-build --index <GSPC, MID or SML> --from <yyyy-MM-dd> --through <yyyy-MM-dd>
#   tools/ledger-build ... --again    write the span again, replacing what an earlier build wrote
#   tools/ledger-build ... --check    print what a run would build and run, and run nothing
set -euo pipefail

# The root in the form the platform's own tools read, as tools/nightly reads it.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && (pwd -W 2>/dev/null || pwd))"
cd "$root"

data="${EquityBrief__DataRoot:-$root/data}"
case "$data" in
    /*|[A-Za-z]:*) ;;
    *) data="$root/$data" ;;
esac
mkdir -p "$data"

check=0
pass=()

for argument in "$@"; do
    case "$argument" in
        --check) check=1 ;;
        *) pass+=("$argument") ;;
    esac
done

refuse() {
    echo "ledger-build: refused before any worker exists: $1" >&2
    exit 1
}

branch="$(git symbolic-ref --short -q HEAD || true)"

if [ "$branch" != "main" ]; then
    refuse "the checkout is on '${branch:-no branch}' and not on main, so no build was made from it"
fi

commit="$(git rev-parse HEAD)"
short="${commit:0:12}"
note="built from $short"

if git rev-parse --verify -q refs/remotes/origin/main >/dev/null; then
    ahead="$(git rev-list --count origin/main..HEAD)"

    if [ "$ahead" != 0 ]; then
        refuse "the checkout holds $ahead commit(s) origin/main does not have, so no build was made from it"
    fi

    behind="$(git rev-list --count HEAD..origin/main)"

    if [ "$behind" != 0 ]; then
        note="$note, $behind commit(s) behind origin/main"
    fi
else
    note="$note, with no origin/main to read against"
fi

copies="$data/nights"
copy="$copies/$short"
secrets="$root/src/EquityBrief.Worker/appsettings.Secrets.json"

worker_in() {
    find "$1/src/EquityBrief.Worker/bin/Release" -name EquityBrief.Worker.dll 2>/dev/null | head -n 1 || true
}

built="$(worker_in "$copy")"

if [ "$check" = 1 ]; then
    echo "ledger-build: would run $commit, $note"
    echo "ledger-build: copy $copy, ${built:+built already}${built:-to build}"
    echo "ledger-build: data root $data"
    echo "ledger-build: secrets read from $secrets, none copied"
    exit 0
fi

if [ -z "$built" ]; then
    started=$SECONDS
    rm -rf "$copy" "$copy.partial"
    mkdir -p "$copy.partial"
    git archive "$commit" | tar -x -C "$copy.partial"
    dotnet build "$copy.partial/src/EquityBrief.Worker" -c Release --nologo -v quiet
    mv "$copy.partial" "$copy"
    built="$(worker_in "$copy")"

    if [ -z "$built" ]; then
        echo "ledger-build: the build of $short left no worker assembly under $copy" >&2
        exit 1
    fi

    note="$note, built in $((SECONDS - started)) s"
else
    note="$note, build reused"
fi

touch "$copy"

echo "ledger-build: $note"

export EquityBrief__DataRoot="$data"
export EquityBrief__SecretsFile="$secrets"

exec dotnet "$built" ledger-build "${pass[@]}"
