<Project Sdk="Microsoft.NET.Sdk">

  <!-- The suite. It references every project by design, which is why
       api-isolation reads EquityBrief.Api's dependency file rather than this
       project's. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The suite is also the harness. tools/verify-phase runs it as a command,
         so it carries its own entry point rather than the generated one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EquityBrief.Core\EquityBrief.Core.csproj" />
    <ProjectReference Include="..\EquityBrief.Data\EquityBrief.Data.csproj" />
    <ProjectReference Include="..\EquityBrief.Web\EquityBrief.Web.csproj" />
    <ProjectReference Include="..\EquityBrief.Api\EquityBrief.Api.csproj" />
    <ProjectReference Include="..\EquityBrief.Worker\EquityBrief.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
