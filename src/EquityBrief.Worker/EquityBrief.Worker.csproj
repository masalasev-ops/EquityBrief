<Project Sdk="Microsoft.NET.Sdk">

  <!-- The nightly run and the overnight queue, and the sole writer. A command an
       external scheduler invokes, not a service that schedules itself.
       see: Nothing is written against one operating system -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Secrets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EquityBrief.Core\EquityBrief.Core.csproj" />
    <ProjectReference Include="..\EquityBrief.Data\EquityBrief.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>

</Project>
